# ── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string (e.g. Neon, Supabase, or local Postgres)
DATABASE_URL="postgresql://user:password@localhost:5432/task-manager-app"

# ── Kinde Authentication ─────────────────────────────────────────────────────
# From your Kinde dashboard: Settings → Environment → App Keys
KINDE_CLIENT_ID=""
KINDE_CLIENT_SECRET=""
KINDE_ISSUER_URL="https://<your-business>.kinde.com"

# Where Kinde redirects after login/logout
KINDE_SITE_URL="http://localhost:3000"
KINDE_POST_LOGIN_REDIRECT_URL="http://localhost:3000/onboarding"
KINDE_POST_LOGOUT_REDIRECT_URL="http://localhost:3000"

# ── Kinde Management API (optional — used for account deletion) ──────────────
# From your Kinde dashboard: Settings → APIs → Management API
# Only needed if you enable the "delete account" feature.
KINDE_MANAGEMENT_CLIENT_ID=""
KINDE_MANAGEMENT_CLIENT_SECRET=""

# ── Ably (real-time notifications) ───────────────────────────────────────────
# From https://ably.com — API key with publish & subscribe capabilities
ABLY_API_KEY=""

# ── UploadThing (file attachments) ───────────────────────────────────────────
# From your UploadThing dashboard: https://uploadthing.com
UPLOADTHING_TOKEN=""
